## Variables
VERSION ?= $(shell cat ../DUCKDB_VERSION)
DUCKDB_REPO = https://github.com/duckdb/duckdb
DUCKDB_DIR = ./duckdb
BUILD_DIR = ./build
LIB_DIR = ./Libraries/release
EXTENSIONS = 'icu;parquet;json;autocomplete;core_functions'
# common environment variables
export CMAKE_TOOLCHAIN_FILE=$(PWD)/ios.toolchain.cmake
export BUILD_SHELL=0
export CCACHE_DIR=$(PWD)/.ccache
export BUILD_TESTING=OFF
export BUILD_UNITTESTS=OFF

CMAKE_COMMON = -G Ninja -DFORCE_COLORED_OUTPUT=1 -DBUILD_EXTENSIONS=$(EXTENSIONS) \
	-DLOCAL_EXTENSION_REPO="" -DBUILD_SHELL=0 \
	-DCMAKE_TOOLCHAIN_FILE=$(CMAKE_TOOLCHAIN_FILE) -DCMAKE_BUILD_TYPE=Release

# $(1) build subdir, $(2) arch, $(3) iOS platform, $(4) duckdb platform
define build_framework
	@mkdir -p $(BUILD_DIR)/$(1) $(CCACHE_DIR)
	@cd $(BUILD_DIR)/$(1) && \
	OSX_BUILD_ARCH=$(2) IOS_PLATFORM=$(3) DUCKDB_PLATFORM=$(4) BUILD_SHELL=0 \
	cmake $(CMAKE_COMMON) -DOSX_BUILD_ARCH=$(2) -DIOS_PLATFORM=$(3) \
	-DDUCKDB_EXPLICIT_PLATFORM=$(4) ../.. && \
	cmake --build . --target duckdb_framework
	@test -f $(BUILD_DIR)/$(1)/duckdb.framework/Headers/duckdb.h \
		|| { echo "error: $(1) framework is missing Headers/duckdb.h"; exit 1; }
endef

.PHONY: all reset clean duckdb device simulator both release help

all: both ## Build both Device and Simulator

reset: ## Reset build environment
	rm -rf $(LIB_DIR) $(DUCKDB_DIR) $(BUILD_DIR)

clean: ## Drop the build trees, keep the DuckDB checkout
	rm -rf $(BUILD_DIR)

duckdb: ## Shallow clone the pinned upstream DuckDB
	git clone --depth 1 --branch "$(VERSION)" $(DUCKDB_REPO) $(DUCKDB_DIR)

device: duckdb ## iOS Hardware Build
	$(call build_framework,device,arm64,iPhoneOS,osx_arm64)
	@mkdir -p $(LIB_DIR)
	@rm -rf $(LIB_DIR)/duckdb.framework
	@mv $(BUILD_DIR)/device/duckdb.framework $(LIB_DIR)/duckdb.framework
	@echo "iOS Device Build Complete"

simulator: ## Universal iOS Simulator Build (reuses the checkout from `device`)
	$(call build_framework,sim-x86_64,x86_64,iPhoneSimulator,osx_amd64)
	$(call build_framework,sim-arm64,arm64,iPhoneSimulator,osx_arm64)
	@mkdir -p $(LIB_DIR)
	@rm -rf $(LIB_DIR)/duckdb.framework.sim
	@mv $(BUILD_DIR)/sim-arm64/duckdb.framework $(LIB_DIR)/duckdb.framework.sim
	@lipo -create $(LIB_DIR)/duckdb.framework.sim/duckdb \
		$(BUILD_DIR)/sim-x86_64/duckdb.framework/duckdb \
		-output $(LIB_DIR)/duckdb.framework.sim/duckdb
	@echo "Universal Simulator Build Complete"

both: reset device simulator ## Build both Device and Simulator
	@echo "Both Device and Simulator builds complete"

release: both ## Build both device and simulator
	@echo "Release build complete"

help: ## Display this help message
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-30s\033[0m %s\n", $$1, $$2}'
